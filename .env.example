# Copy to .env and fill in real values.

# Connection string the API and migration scripts use to reach Postgres.
# Use the least-privileged role created by db/init/002_create_app_role.sh,
# NOT the postgres superuser, even in development.
DATABASE_URL=postgresql://logicle_app:app_password_change_me@127.0.0.1:5432/logicle

# Password the init script sets on the logicle_app role. Must match the
# password embedded in DATABASE_URL above. Override before `docker compose up`
# on a fresh data volume.
APP_DB_PASSWORD=app_password_change_me

# SMTP (only used by the password reset flow).
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Secret used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse the dev value in prod.
JWT_SECRET=

# Origin of the deployed frontend, for credentialed CORS in prod
# (e.g. https://logicle.example.com). Leave unset in dev.
FRONTEND_ORIGIN=

# Path to a CA cert file for verifying the DB server's TLS certificate.
# Only needed for non-loopback DATABASE_URL hosts; most managed Postgres
# providers (Neon, Supabase, RDS) hand you this or use a public CA already
# trusted by Node, in which case leave this unset.
DB_SSL_CA=

# Set in Vercel's dashboard (Settings > Environment Variables) — Vercel
# auto-generates this and sends it as `Authorization: Bearer <value>` on
# scheduled Cron invocations, which /api/cron/keepalive checks. Leave unset
# in local dev.
CRON_SECRET=
